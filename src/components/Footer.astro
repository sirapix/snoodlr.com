---
const { currentPath = "/" } = Astro.props;
const isContact = currentPath.startsWith("/contact");
---

<footer class="border-t border-border/60 bg-background">
  <div class="mx-auto max-w-7xl px-6 py-12">
    <div class="flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
      <div>
        <p class="font-display text-lg font-semibold tracking-tight">Snoodlr</p>
        <p class="mt-1 text-sm text-muted-foreground">Helpful conversations. Real results.</p>
      </div>
      <nav class="flex flex-wrap gap-6 text-sm text-muted-foreground" aria-label="Footer">
        <a href="/#how-it-works" class="hover:text-foreground">How it works</a>
        <a href="/#use-cases" class="hover:text-foreground">Use cases</a>
        <a href="/#wordpress" class="hover:text-foreground">WordPress</a>
        <a href="/contact" class={isContact ? "text-foreground" : "hover:text-foreground"} aria-current={isContact ? "page" : undefined}>Contact</a>
      </nav>
    </div>
    <div class="mt-10 flex flex-col items-start justify-between gap-3 border-t border-border/60 pt-6 text-xs text-muted-foreground md:flex-row md:items-center">
      <p>&copy; 2026 Snoodlr. All rights reserved.</p>
      <p>AI business assistant for leads, orders, and support.</p>
    </div>
  </div>
</footer>
