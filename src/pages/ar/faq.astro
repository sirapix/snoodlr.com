---
import BaseLayout from "../../components/BaseLayout.astro";
import Button from "../../components/Button.astro";
import ButtonLink from "../../components/ButtonLink.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import FaqSections from "../../components/FaqSections.astro";
import { AR_APP_LOGIN_URL } from "../../lib/links";
import { monthlyPriceLabel } from "../../lib/pricing";

const faqSections = [
  {
    id: "getting-started",
    label: "البدء",
    title: "من إنشاء الحساب إلى أول محادثة",
    description: "الأساسيات لفهم Snoodlr وإطلاق مساعد نشاطك الأول.",
    items: [
      {
        question: "ما هو Snoodlr؟",
        answer: "Snoodlr هو مساعد أعمال بالذكاء الاصطناعي وصندوق وارد موحّد. يجيب عن أسئلة العملاء اعتمادًا على مصادر النشاط التي تعتمدها، ويجمع بيانات العملاء والطلبات، ويمنح فريقك مكانًا واحدًا لمراجعة المحادثات والمتابعة."
      },
      {
        question: "كيف أبدأ؟",
        answer: "أنشئ حسابك، ثم استخدم خطوات التأهيل لإضافة نشاطك الأول ومصادره المعتمدة. بعد تجهيز المحتوى، يمكنك تفعيل مساعد الموقع من مساحة عملك في Snoodlr."
      },
      {
        question: "ما المعلومات التي يمكن أن يستخدمها Snoodlr؟",
        answer: "يمكنك ربط صفحات موقعك وإضافة مستندات وسياسات وأسئلة شائعة ومواد أخرى معتمدة من نشاطك. كما يمكن لمتاجر WordPress وWooCommerce المتصلة توفير سياق أغنى عن المنتجات والمتجر عبر الإضافة الرسمية."
      }
    ]
  },
  {
    id: "using-snoodlr",
    label: "استخدام Snoodlr",
    title: "القنوات والتحكم وتعاون الفريق",
    description: "كيف تبدو تجربة العميل، وكيف يبقى فريقك حاضرًا عند الحاجة.",
    items: [
      {
        question: "أين يمكن للعملاء التحدث مع المساعد؟",
        answer: "ودجت الموقع هو التجربة الأساسية. ويتوفر دعم WordPress وWooCommerce عبر إضافة Snoodlr، بينما تتاح قنوات واتساب وفيسبوك/ماسنجر وغيرها من القنوات المتصلة عند تفعيلها لحسابك وضمن خطتك."
      },
      {
        question: "هل يستطيع فريقي التدخل في المحادثة؟",
        answer: "نعم. يستطيع فريقك مراجعة المحادثات في صندوق الوارد الموحّد، ومعرفة الحالات التي تحتاج إلى تدخل بشري، وإرسال رد يدوي عندما يحتاج الطلب إلى تقدير أو موافقة أو لمسة شخصية."
      },
      {
        question: "هل يدعم Snoodlr العربية والإنجليزية؟",
        answer: "نعم. يوفر Snoodlr تجربة بالعربية والإنجليزية، ويمكن ضبط أي منهما كلغة افتراضية لودجت الموقع. وتكون الإجابات أقوى عندما يتوفر محتوى نشاط معتمد باللغة التي يستخدمها عملاؤك."
      },
      {
        question: "ماذا يحدث إذا لم تتوفر لدى المساعد معلومات كافية؟",
        answer: "صُمم Snoodlr حول مصادرك المعتمدة ووضوح المحادثات لفريقك. يستطيع الفريق مراجعة المحادثة، وتحديد المعلومات الناقصة، وتحديث المصدر المناسب أو إعادة فهرسته، والتدخل شخصيًا عندما يتطلب الطلب شخصًا."
      }
    ]
  },
  {
    id: "plans-and-billing",
    label: "الخطط والفوترة",
    title: "مسار واضح من التجربة إلى التوسع",
    description: "ابدأ من دون تكلفة، واختبر Snoodlr في محادثات حقيقية، ثم توسّع مع فريقنا عندما يحين الوقت المناسب.",
    items: [
      {
        question: "هل يمكنني تجربة Snoodlr قبل اختيار خطة مدفوعة؟",
        answer: "نعم. نرحب بك لتبدأ مجانًا وتختبر Snoodlr خلال مرحلة الإطلاق التجريبي قبل أن تقرر ما إذا كنت تحتاج إلى استخدام أو مواقع أو قنوات أو أدوات تحكم إضافية."
      },
      {
        question: "ما الخطط المدفوعة المتاحة؟",
        answer: `الخطة الأساسية بسعر ${monthlyPriceLabel("essential")} شهريًا، وخطة الأعمال بسعر ${monthlyPriceLabel("business")} شهريًا. أما خطط المؤسسات فتُصمم للإطلاقات الأكبر والحدود المخصصة ومتطلبات التكامل أو المشتريات.`
      },
      {
        question: "كيف أرقّي خطتي وأدفع؟",
        answer: "خلال مرحلة الإطلاق التجريبي الحالية، يرتّب فريقنا كل ترقية مدفوعة بصورة شخصية بدلًا من تحويلك إلى صفحة دفع آلية. افتح محادثة Snoodlr وأخبرنا بالخطة التي تفكر فيها؛ سنؤكد معك الخيار الأنسب، ونوضح لك خطوات الدفع، ونتولى التفعيل معك. يمنح هذا النهج المباشر عملاءنا الأوائل تجربة تأهيل أكثر عناية بينما نكمل طرح نظام الاشتراكات."
      },
      {
        question: "هل تتوفر الفوترة السنوية؟",
        answer: "ليس بعد. تتم فوترة الخطط المدفوعة شهريًا في الوقت الحالي. إذا كان لديك إطلاق أكبر أو متطلبات مشتريات محددة، فتحدث مع فريقنا حول ترتيب يناسب المؤسسات."
      }
    ]
  }
];

const faqItems = faqSections.flatMap((section) => section.items);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "https://snoodlr.com/ar/faq#faq-page",
  url: "https://snoodlr.com/ar/faq",
  name: "الأسئلة الشائعة حول Snoodlr",
  inLanguage: "ar",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer
    }
  }))
};
---

<BaseLayout
  lang="ar"
  title="الأسئلة الشائعة عن Snoodlr - المنتج والإعداد والخطط والفوترة"
  description="إجابات عن الأسئلة الشائعة حول إعداد Snoodlr والمصادر المعتمدة والقنوات والتدخل البشري والخطط والتجربة والترقية والفوترة."
  ogTitle="الأسئلة الشائعة عن Snoodlr"
  ogDescription="إجابات واضحة حول استخدام Snoodlr وربط نشاطك والترقية خلال مرحلة الإطلاق التجريبي."
  path="/ar/faq"
  dateModified="2026-09-03"
  keywords={[
    "أسئلة Snoodlr الشائعة",
    "إعداد Snoodlr",
    "ترقية Snoodlr",
    "فوترة Snoodlr",
    "تجربة Snoodlr"
  ]}
  jsonLd={jsonLd}
>
  <main class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[48rem] bg-hero-glow"></div>

    <section class="relative py-20 md:py-28">
      <div class="mx-auto grid max-w-7xl items-center gap-12 px-6 lg:grid-cols-[minmax(0,1.1fr)_minmax(22rem,0.9fr)] lg:gap-20">
        <div class="max-w-3xl">
          <Eyebrow label="الأسئلة الشائعة" />
          <h1 class="mt-6 text-balance text-5xl font-semibold tracking-tight md:text-6xl">إجابات واضحة، من دون تعقيد.</h1>
          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted-foreground">تعرّف على طريقة عمل Snoodlr اليوم، وما يمكنك ربطه، وكيف يدعمك فريقنا من التجربة المجانية حتى الإطلاق المدفوع.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <ButtonLink href="/ar/pricing" lang="ar">استكشف الخطط</ButtonLink>
            <ButtonLink href={AR_APP_LOGIN_URL} variant="secondary" lang="ar">ابدأ مجانًا</ButtonLink>
          </div>
        </div>

        <aside class="relative overflow-hidden rounded-3xl border border-primary/30 bg-gradient-to-br from-primary/15 via-card to-card p-7 shadow-frame md:p-9">
          <div class="absolute -left-16 -top-16 h-48 w-48 rounded-full bg-primary/15 blur-3xl"></div>
          <div class="relative">
            <span class="inline-flex rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.08em] text-primary">الدخول التجريبي</span>
            <h2 class="mt-5 text-2xl font-semibold tracking-tight md:text-3xl">ترقية تُنسّق معك شخصيًا.</h2>
            <p class="mt-3 leading-relaxed text-muted-foreground">نرحب بك لتختبر Snoodlr في محادثات عملاء حقيقية من دون تكلفة. وعندما تصبح مستعدًا للتوسع، يساعدك فريقنا في اختيار الخطة المناسبة وترتيبها وتفعيلها معك.</p>
            <Button type="button" data-snoodlr-open-chat aria-label="افتح المحادثة لمناقشة ترقية Snoodlr" size="md" lang="ar" class="mt-6">
              ناقش الترقية
            </Button>
          </div>
        </aside>
      </div>
    </section>

    <section class="relative border-y border-border/60 bg-surface/30 py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-6">
        <FaqSections sections={faqSections} />
      </div>
    </section>

    <section class="relative px-6 py-20 md:py-28">
      <div class="mx-auto max-w-5xl rounded-3xl border border-border-strong/60 bg-card p-9 text-center shadow-frame md:p-14">
        <p class="text-xs font-semibold uppercase tracking-[0.08em] text-primary">هل لديك سؤال آخر؟</p>
        <h2 class="mt-4 text-balance text-3xl font-semibold tracking-tight md:text-4xl">اسألنا عن نشاطك وخطة إطلاقك.</h2>
        <p class="mx-auto mt-3 max-w-xl leading-relaxed text-muted-foreground">يمكن لفريقنا مساعدتك في اختيار الخطة أو القنوات المدعومة أو الإعداد أو أي متطلبات أكثر تحديدًا.</p>
        <div class="mt-7 flex flex-wrap justify-center gap-3">
          <Button type="button" data-snoodlr-open-chat aria-label="افتح محادثة Snoodlr" lang="ar">افتح المحادثة</Button>
          <ButtonLink href="/ar/contact" variant="secondary" lang="ar">أرسل رسالة</ButtonLink>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
