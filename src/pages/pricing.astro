---
import BaseLayout from "../components/BaseLayout.astro";
import Button from "../components/Button.astro";
import CheckIcon from "../components/CheckIcon.astro";
import CtaBand from "../components/CtaBand.astro";
import Eyebrow from "../components/Eyebrow.astro";
import { monthlyPriceLabel, PLAN_PRICES_USD } from "../lib/pricing";

const plans = [
  {
    key: "free",
    name: "Free start",
    price: "$0",
    cadence: "to start",
    monthlyPriceUsd: 0,
    description: "Try Snoodlr on your website and learn what customers ask before choosing a paid plan.",
    cta: "Start free",
    featured: false,
    features: ["Website assistant", "Approved business sources", "Basic lead capture", "Conversations in the portal", "Team-assisted upgrade path"]
  },
  {
    key: "essential",
    name: "Essential",
    price: monthlyPriceLabel("essential"),
    cadence: "/ month",
    monthlyPriceUsd: PLAN_PRICES_USD.essential,
    description: "For businesses that need more usage, properties, channels, and controls.",
    cta: "Talk to us",
    featured: true,
    features: ["Higher conversation usage", "More properties or assistants", "Advanced lead capture", "Unified inbox for supported channels", "Social messages and comments as enabled", "WordPress plugin availability"]
  },
  {
    key: "business",
    name: "Business",
    price: monthlyPriceLabel("business"),
    cadence: "/ month",
    monthlyPriceUsd: PLAN_PRICES_USD.business,
    description: "For teams that need rollout support, review workflows, and broader channel needs.",
    cta: "Contact us",
    featured: false,
    features: ["Multiple properties", "Team handoff workflows", "WooCommerce support through the plugin", "Usage and access controls", "Analytics, comments, and conversation review"]
  },
  {
    key: "enterprise",
    name: "Enterprise",
    price: "Custom",
    cadence: "",
    monthlyPriceUsd: null,
    description: "For larger organizations with custom limits, onboarding, or integration requirements.",
    cta: "Contact us",
    featured: false,
    features: ["Custom usage and property limits", "Rollout planning", "Channel requirements review", "Priority support options", "Security and procurement discussion"]
  }
];

const rows = [
  ["Website widget", true, true, true, true],
  ["Approved website, docs, and policies", true, true, true, true],
  ["Lead capture", "Basic", "Advanced", "Advanced", "Custom"],
  ["Conversations and leads portal", true, true, true, true],
  ["Unified inbox for connected channels", false, true, true, true],
  ["Social messages and comments", false, "As enabled", "As enabled", "As enabled"],
  ["Conversation review and missing-info updates", "Basic", "Advanced", "Advanced", "Custom"],
  ["Higher usage limits", false, true, true, true],
  ["More properties or assistants", false, true, true, true],
  ["Supported channels beyond website", false, "As enabled", "As enabled", "As enabled"],
  ["WordPress plugin", false, "Available", "Available", "Available"],
  ["WooCommerce store support", false, "With plugin", "With plugin", "With plugin"],
  ["Advanced controls", false, true, true, true],
  ["Rollout support", false, false, true, true],
  ["Custom limits or requirements", false, false, "Discuss", "Custom"]
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": "https://snoodlr.com/#software",
    name: "Snoodlr",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    url: "https://snoodlr.com/pricing",
    description: "Snoodlr pricing starts free, with paid plans for unified inbox capabilities, higher usage, more properties, supported channels, and advanced controls.",
    publisher: {
      "@id": "https://snoodlr.com/#organization"
    },
    offers: plans.map((plan) => ({
      "@type": "Offer",
      name: plan.name,
      ...(plan.monthlyPriceUsd !== null
        ? {
            price: String(plan.monthlyPriceUsd),
            priceCurrency: "USD",
            ...(plan.key !== "free"
              ? {
                  priceSpecification: {
                    "@type": "UnitPriceSpecification",
                    price: String(plan.monthlyPriceUsd),
                    priceCurrency: "USD",
                    billingDuration: "P1M"
                  }
                }
              : {})
          }
        : { description: "Custom monthly pricing" })
    }))
  }
];
---

<BaseLayout
  title="Pricing - Snoodlr AI business assistant"
  description="Start Snoodlr for free, then choose Essential at $30 per month or Business at $85 per month. Paid plans are billed monthly; annual billing is not available yet."
  ogTitle="Pricing - Snoodlr"
  ogDescription="Free to start. Essential is $30 per month and Business is $85 per month. Paid plans are billed monthly; annual billing is not available yet."
  path="/pricing"
  keywords={[
    "Snoodlr pricing",
    "AI business assistant pricing",
    "AI chatbot pricing",
    "AI lead capture pricing",
    "WooCommerce AI assistant pricing"
  ]}
  jsonLd={jsonLd}
>
  <main class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 bg-hero-glow"></div>

    <section class="relative py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-6">
        <div class="mx-auto max-w-3xl text-center">
          <Eyebrow label="Pricing" />
          <h1 class="mt-5 text-balance text-4xl font-semibold tracking-tight md:text-5xl">Simple pricing. Serious outcomes.</h1>
          <p class="mt-5 text-lg leading-relaxed text-muted-foreground">Start free on your website, then choose the monthly plan that fits your next stage. Annual billing is not available yet.</p>
        </div>

        <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {plans.map((plan) => (
            <div class={`relative flex flex-col rounded-3xl border p-7 ${plan.featured ? "border-primary/60 bg-card shadow-frame" : "border-border/60 bg-card/60"}`}>
              {plan.featured && <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-primary px-3 py-0.5 text-xs font-semibold text-primary-foreground">Most popular</span>}
              <div class="flex-1">
                <h2 class="text-lg font-semibold tracking-tight">{plan.name}</h2>
                <div class="mt-2 flex items-baseline gap-1">
                  <span class="text-4xl font-semibold tracking-tight">{plan.price}</span>
                  {plan.cadence && <span class="text-sm text-muted-foreground">{plan.cadence}</span>}
                </div>
                <p class="mt-2 text-sm text-muted-foreground">{plan.description}</p>
                <ul class="mt-6 space-y-2.5">
                  {plan.features.map((feature) => (
                    <li class="flex items-start gap-2 text-sm text-foreground">
                      <CheckIcon />
                      {feature}
                    </li>
                  ))}
                </ul>
              </div>
              <Button
                type="button"
                data-snoodlr-open-chat
                data-plan-chat={plan.key}
                aria-label={`Open chat about the ${plan.name} plan`}
                size="card"
                variant={plan.featured ? "primary" : "secondary"}
                block
                class="mt-7"
              >
                {plan.cta}
              </Button>
            </div>
          ))}
        </div>

        <p class="mt-8 text-center text-sm text-muted-foreground">Paid plans use monthly billing today. Annual billing is not available yet, and activation is handled with our team.</p>
      </div>
    </section>

    <section class="relative border-y border-border/60 bg-surface/30 py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-6">
        <div class="max-w-3xl">
          <Eyebrow label="Compare" />
          <h2 class="mt-5 text-balance text-4xl font-semibold tracking-tight md:text-5xl">What's included</h2>
          <p class="mt-5 text-lg leading-relaxed text-muted-foreground">Every plan starts with the core Snoodlr experience. Upgrade when you need more volume, properties, supported channels, and control.</p>
        </div>

        <div class="mt-12 overflow-x-auto">
          <table class="w-full min-w-[640px] text-left text-sm">
            <thead>
              <tr class="border-b border-border-strong">
                <th class="py-3 pr-4 font-medium text-muted-foreground">Feature</th>
                {plans.map((plan) => <th class="px-4 py-3 font-semibold text-foreground">{plan.name}</th>)}
              </tr>
            </thead>
            <tbody>
              {rows.map(([label, free, essential, business, enterprise]) => (
                <tr class="border-b border-border/40">
                  <td class="py-3 pr-4 font-medium text-foreground">{label}</td>
                  {[free, essential, business, enterprise].map((value) => (
                    <td class="px-4 py-3 text-muted-foreground">
                      {value === true ? <CheckIcon /> : value === false ? <span class="text-muted-foreground/40">&mdash;</span> : <span>{value}</span>}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <CtaBand />
  </main>
</BaseLayout>
