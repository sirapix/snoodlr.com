---
import { localizedPath, type SiteLang } from "../lib/links";

const { currentPath = "/", lang = "en" } = Astro.props;
const siteLang = lang as SiteLang;
const isArabic = siteLang === "ar";
const homePath = localizedPath(siteLang, "/");
const faqPath = localizedPath(siteLang, "/faq");
const contactPath = localizedPath(siteLang, "/contact");
const isFaq = currentPath.endsWith("/faq");
const isContact = currentPath.endsWith("/contact");
const labels = isArabic
  ? {
      tagline: "محادثات مفيدة. نتائج حقيقية.",
      how: "طريقة العمل",
      cases: "الاستخدامات",
      wordpress: "ووردبريس",
      faq: "الأسئلة الشائعة",
      contact: "تواصل معنا",
      rights: "جميع الحقوق محفوظة.",
      description: "مساعد أعمال بالذكاء الاصطناعي للعملاء المحتملين والطلبات والدعم."
    }
  : {
      tagline: "Helpful conversations. Real results.",
      how: "How it works",
      cases: "Use cases",
      wordpress: "WordPress",
      faq: "FAQ",
      contact: "Contact",
      rights: "All rights reserved.",
      description: "AI business assistant for leads, orders, and support."
    };
---

<footer class="border-t border-border/60 bg-background">
  <div class="mx-auto max-w-7xl px-6 py-12">
    <div class="flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
      <div>
        <a href={homePath} class="inline-flex" aria-label="Snoodlr home">
          <img src="/assets/snoodlr-logo.svg" alt="Snoodlr" class="h-8 w-auto dark:brightness-0 dark:invert" />
        </a>
        <p class="mt-1 text-sm text-muted-foreground">{labels.tagline}</p>
      </div>
      <nav class="flex flex-wrap gap-6 text-sm text-muted-foreground" aria-label="Footer">
        <a href={`${homePath}#how-it-works`} class="hover:text-foreground">{labels.how}</a>
        <a href={`${homePath}#use-cases`} class="hover:text-foreground">{labels.cases}</a>
        <a href={`${homePath}#wordpress`} class="hover:text-foreground">{labels.wordpress}</a>
        <a href={faqPath} class={isFaq ? "text-foreground" : "hover:text-foreground"} aria-current={isFaq ? "page" : undefined}>{labels.faq}</a>
        <a href={contactPath} class={isContact ? "text-foreground" : "hover:text-foreground"} aria-current={isContact ? "page" : undefined}>{labels.contact}</a>
      </nav>
    </div>
    <div class="mt-10 flex flex-col items-start justify-between gap-3 border-t border-border/60 pt-6 text-xs text-muted-foreground md:flex-row md:items-center">
      <p>&copy; 2026 Snoodlr. {labels.rights}</p>
      <p>{labels.description}</p>
    </div>
  </div>
</footer>
