---
type FaqItem = {
  question: string;
  answer: string;
};

type FaqSection = {
  id: string;
  label: string;
  title: string;
  description: string;
  items: FaqItem[];
};

const { sections } = Astro.props as { sections: FaqSection[] };
---

<div class="divide-y divide-border/60">
  {sections.map((section, sectionIndex) => (
    <section
      id={section.id}
      aria-labelledby={`${section.id}-title`}
      class={`grid gap-8 py-12 lg:grid-cols-[minmax(0,0.62fr)_minmax(0,1.38fr)] lg:gap-16 ${sectionIndex === 0 ? "pt-0" : ""}`}
    >
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">{section.label}</p>
        <h2 id={`${section.id}-title`} class="mt-3 text-2xl font-semibold tracking-tight md:text-3xl">{section.title}</h2>
        <p class="mt-3 max-w-sm leading-relaxed text-muted-foreground">{section.description}</p>
      </div>

      <div class="space-y-3">
        {section.items.map((item, itemIndex) => (
          <details open={sectionIndex === 0 && itemIndex === 0} class="group rounded-2xl border border-border/60 bg-card/70 transition-colors open:border-primary/30 open:bg-card">
            <summary class="flex cursor-pointer list-none items-center gap-4 px-5 py-5 marker:content-none md:px-6">
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-primary/10 text-xs font-semibold text-primary">
                {String(itemIndex + 1).padStart(2, "0")}
              </span>
              <span class="flex-1 text-base font-semibold leading-snug tracking-tight md:text-lg">{item.question}</span>
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-border/70 text-muted-foreground transition-transform duration-200 group-open:rotate-45 group-open:border-primary/30 group-open:text-primary" aria-hidden="true">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none">
                  <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
              </span>
            </summary>
            <div class="px-5 pb-6 ps-[4.25rem] pe-6 text-sm leading-7 text-muted-foreground md:text-base">
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  ))}
</div>
