---
import BaseLayout from "../components/BaseLayout.astro";
import BrowserFrame from "../components/BrowserFrame.astro";
import ButtonLink from "../components/ButtonLink.astro";
import CheckIcon from "../components/CheckIcon.astro";
import ConnectedChannels from "../components/ConnectedChannels.astro";
import CtaBand from "../components/CtaBand.astro";
import Eyebrow from "../components/Eyebrow.astro";
import { APP_LOGIN_URL } from "../lib/links";

const outcomes = [
  ["Answer from approved business content", "Use your website, uploaded documents, store policies, and product data to reply with answers customers can trust."],
  ["Capture the details your team needs", "Collect name, phone, email, and request details while the customer is still interested."],
  ["Save leads for follow-up", "Keep inquiries, contact details, and conversation history inside the Snoodlr portal so your team can follow up."],
  ["Handle everyday questions instantly", "Answer delivery, payment, refund, return, hours, pricing, and contact questions without making visitors wait."],
  ["Move visitors toward the next step", "Help shoppers find products, request an order, book a call, or ask for a human when they need one."],
  ["Bring your team in when it matters", "Let humans step into conversations when a request needs judgment, approval, or a personal touch."]
];

const assistantFeatures = [
  ["Answer from your real business content", "Use approved website pages, uploaded documents, policies, FAQs, and store data so replies reflect how your business actually works."],
  ["Capture leads while customers are interested", "Ask for name, phone, email, and request details in the flow of the conversation, then save them for follow-up."],
  ["Support product discovery and order requests", "Help shoppers compare products, ask about availability, and send order requests for your team to confirm."],
  ["Manage a unified inbox in one place", "Review website chats, supported social messages, social media comments, lead details, customer questions, and follow-up needs from the Snoodlr portal."],
  ["Work across supported customer channels", "Start with your website. Connect WhatsApp, Facebook/Messenger, WordPress/WooCommerce, supported social accounts, and more as integrations are enabled."],
  ["Review answers and fill knowledge gaps", "Keep answers tied to approved sources, identify missing business information, update sources, and let your team step in when a conversation needs a person."]
];

const useCases = [
  ["Local businesses", "Answer hours, pricing, delivery, and contact questions while collecting inquiries for follow-up."],
  ["Online stores", "Help shoppers find products, ask about availability, and send order requests for your team to confirm."],
  ["Service providers", "Qualify service inquiries, collect request details, and route the right conversations to your team."],
  ["Appointment-based businesses", "Answer common admin questions and help visitors request the right appointment."],
  ["Agencies & client sites", "Deploy Snoodlr across client websites with separate business data and source controls."]
];

const businessPoints = [
  "Answers based on approved business sources",
  "Teams can review gaps and manage sources",
  "Unified inbox for messages, comments, and leads",
  "Human handoff when needed",
  "Usage and access are controlled",
  "Website first, supported channels as enabled"
];

const pricingHighlights = [
  ["Free to start", "Launch on your website and see how Snoodlr handles real customer questions before choosing a paid plan."],
  ["Paid plans as you grow", "Upgrade for higher usage, more properties, more channels, and advanced controls."],
  ["Business or Enterprise", "Contact us for larger teams, rollout support, custom limits, and channel requirements."]
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": "https://snoodlr.com/#software",
  name: "Snoodlr",
  alternateName: "Snoodlr AI business assistant",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  url: "https://snoodlr.com/",
  description: "AI business assistant trained on business content to answer questions, capture leads, and support customer conversations.",
  featureList: assistantFeatures.map(([title]) => title),
  audience: {
    "@type": "BusinessAudience",
    audienceType: "Local businesses, online stores, service providers, appointment-based businesses, and agencies"
  },
  publisher: {
    "@id": "https://snoodlr.com/#organization"
  },
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD"
  }
};
---

<BaseLayout
  title="Snoodlr - AI business assistant for leads, orders, and support"
  description="Snoodlr trains an AI assistant on your business content to answer customers, capture leads, and manage messages and comments in one unified inbox."
  ogTitle="Snoodlr - AI business assistant"
  ogDescription="Train an AI assistant on your business sources and manage customer messages, comments, leads, and handoffs from one unified inbox."
  path="/"
  keywords={[
    "AI assistant for business websites",
    "AI chatbot for lead capture",
    "AI support assistant",
    "AI assistant for online stores",
    "approved-source AI assistant"
  ]}
  jsonLd={jsonLd}
>
  <main>
    <section class="relative overflow-hidden pt-16 md:pt-24">
      <div class="pointer-events-none absolute inset-0 bg-hero-glow"></div>
      <div class="pointer-events-none absolute inset-0 bg-grid opacity-40 [mask-image:radial-gradient(ellipse_at_top,black_30%,transparent_70%)]"></div>
      <div class="relative mx-auto max-w-7xl px-6 pb-20 text-center">
        <div class="mx-auto flex justify-center">
          <Eyebrow label="AI business assistant" />
        </div>
        <h1 class="mx-auto mt-6 max-w-4xl text-balance text-5xl font-semibold leading-[1.05] tracking-tight md:text-7xl">
          Turn customer conversations into <span class="text-primary">leads, orders, and support.</span>
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-lg leading-relaxed text-muted-foreground md:text-xl">
          Train an AI assistant on your website, documents, policies, and store data so it can answer from your business, capture leads, and help customers take the next step.
        </p>
        <div class="mt-9 flex flex-wrap justify-center gap-3">
          <ButtonLink href={APP_LOGIN_URL}>Start free</ButtonLink>
          <ButtonLink href="#how-it-works" variant="secondary">See how it works</ButtonLink>
        </div>

        <div class="relative mt-20">
          <div class="pointer-events-none absolute -inset-x-20 -inset-y-10 bg-hero-glow opacity-60"></div>
          <div class="relative">
            <BrowserFrame title="snoodlr.app - Inbox" class="mx-auto w-full max-w-3xl">
              <div class="grid grid-cols-12 gap-0 text-sm">
                <aside class="col-span-4 hidden border-r border-border/60 p-5 md:block">
                  <div class="mb-4 flex items-center gap-2">
                    <div class="h-7 w-7 rounded-md bg-primary/20 ring-1 ring-primary/40"></div>
                    <div class="h-3 w-20 rounded bg-muted"></div>
                  </div>
                  <ConnectedChannels class="mb-4" />
                  {[
                    ["New leads", "12", true],
                    ["Active chats", "4", false],
                    ["Order requests", "7", false],
                    ["Follow-ups", "3", false]
                  ].map(([label, value, active]) => (
                    <div class={`mb-1 flex items-center justify-between rounded-lg px-3 py-2 ${active ? "bg-primary/10 text-foreground" : "text-muted-foreground"}`}>
                      <span>{label}</span>
                      <span class="rounded-full bg-surface px-2 py-0.5 text-xs">{value}</span>
                    </div>
                  ))}
                </aside>
                <div class="col-span-12 p-5 md:col-span-8">
                  <div class="mb-4 flex items-center justify-between gap-4">
                    <div>
                      <p class="font-semibold">Jordan from Austin</p>
                      <p class="text-xs text-muted-foreground">Visiting /products &middot; just now</p>
                    </div>
                    <span class="rounded-full bg-primary/15 px-2.5 py-1 text-xs font-medium text-primary">Qualified lead</span>
                  </div>
                  <ConnectedChannels compact class="mb-4 md:hidden" labels={{ heading: "Channels" }} />
                  <div class="space-y-3">
                    <div class="flex justify-start">
                      <div class="max-w-[78%] rounded-2xl bg-surface px-4 py-2.5 text-sm leading-relaxed text-foreground ring-1 ring-border">Hi! Do you deliver to my area?</div>
                    </div>
                    <div class="flex justify-end">
                      <div class="max-w-[78%] rounded-2xl bg-primary px-4 py-2.5 text-sm leading-relaxed text-primary-foreground">Share your ZIP code and preferred date, and I can save the request for our team to confirm.</div>
                    </div>
                    <div class="flex justify-start">
                      <div class="max-w-[78%] rounded-2xl bg-surface px-4 py-2.5 text-sm leading-relaxed text-foreground ring-1 ring-border">78704, hoping for Friday. My email is jordan@example.com.</div>
                    </div>
                    <div class="rounded-xl border border-primary/30 bg-primary/5 p-3 text-xs text-muted-foreground">
                      <span class="font-medium text-primary">Snoodlr</span> saved lead details &middot; delivery request &middot; Friday follow-up
                    </div>
                  </div>
                </div>
              </div>
            </BrowserFrame>
          </div>
        </div>
      </div>
    </section>

    <section class="relative py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-6">
        <div class="grid items-center gap-12 md:grid-cols-2">
          <div class="max-w-3xl">
            <Eyebrow label="The problem" />
            <h2 class="mt-5 text-balance text-4xl font-semibold tracking-tight md:text-5xl">Customers ask, wait, <span class="text-muted-foreground">and quietly leave.</span></h2>
            <p class="mt-5 text-lg leading-relaxed text-muted-foreground">Most websites lose conversations before they ever turn into business. A pricing question, a delivery question, an availability check - every minute of silence costs you a customer.</p>
          </div>
          <div class="rounded-3xl border border-border/60 bg-surface/60 p-8 md:p-10">
            <p class="text-2xl font-medium leading-snug tracking-tight md:text-3xl">Snoodlr responds from your approved content and captures intent while it's high - so the conversation actually becomes an outcome.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="relative border-y border-border/60 bg-surface/30 py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-6">
        <div class="max-w-3xl">
          <Eyebrow label="Outcomes, not features" />
          <h2 class="mt-5 text-balance text-4xl font-semibold tracking-tight md:text-5xl">What Snoodlr actually does for your business.</h2>
        </div>
        <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {outcomes.map(([title, description], index) => (
            <div class="group relative rounded-2xl border border-border/60 bg-card p-7 transition-colors hover:border-primary/40">
              <div class="mb-5 inline-flex h-9 w-9 items-center justify-center rounded-lg bg-primary/15 text-sm font-semibold text-primary">{String(index + 1).padStart(2, "0")}</div>
              <h3 class="text-xl font-semibold tracking-tight">{title}</h3>
              <p class="mt-2 text-muted-foreground">{description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="relative py-20 md:py-28" id="how-it-works">
      <div class="mx-auto max-w-7xl px-6">
        <div class="max-w-3xl">
          <Eyebrow label="How it works" />
          <h2 class="mt-5 text-balance text-4xl font-semibold tracking-tight md:text-5xl">Live in minutes. Helpful from day one.</h2>
        </div>
        <div class="mt-12 grid gap-6 md:grid-cols-3">
          {[
            ["Add your business", "Tell Snoodlr who you are, what you sell, and how you help customers."],
            ["Connect approved sources", "Point Snoodlr at your website, documents, policies, FAQs, or store data so answers come from your business."],
            ["Snoodlr starts helping customers", "Your assistant goes live - answering questions, collecting leads, and handing off when a person should step in."]
          ].map(([title, description], index) => (
            <div class="relative overflow-hidden rounded-2xl border border-border/60 bg-card p-8">
              <p class="font-display text-6xl font-semibold text-primary/30">{String(index + 1).padStart(2, "0")}</p>
              <h3 class="mt-4 text-xl font-semibold tracking-tight">{title}</h3>
              <p class="mt-2 text-muted-foreground">{description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="relative border-y border-border/60 bg-surface/30 py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-6">
        <div class="max-w-3xl">
          <Eyebrow label="What it needs" />
          <h2 class="mt-5 text-balance text-4xl font-semibold tracking-tight md:text-5xl">Everything your AI assistant needs to help customers.</h2>
          <p class="mt-5 text-lg leading-relaxed text-muted-foreground">Give Snoodlr the sources, channels, and controls that make it useful for real customer conversations.</p>
        </div>
        <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {assistantFeatures.map(([title, description]) => (
            <div class="rounded-2xl border border-border/60 bg-card p-7 transition-colors hover:border-primary/40">
              <h3 class="text-xl font-semibold tracking-tight">{title}</h3>
              <p class="mt-2 text-muted-foreground">{description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="relative py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-6">
        <div class="max-w-3xl">
          <Eyebrow label="A closer look" />
          <h2 class="mt-5 text-balance text-4xl font-semibold tracking-tight md:text-5xl">One assistant, working across your business.</h2>
          <p class="mt-5 text-lg leading-relaxed text-muted-foreground">A clean portal for your team, a thoughtful website widget for your customers, and supported channels you can connect as your business grows.</p>
        </div>
        <div class="mt-12 grid gap-6 lg:grid-cols-2">
          <BrowserFrame title="snoodlr.app - Dashboard" class="w-full">
            <div class="p-5">
              <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
                {[
                  ["Conversations", "1,284"],
                  ["Leads captured", "342"],
                  ["Order requests", "97"],
                  ["Avg. response", "1.2s"]
                ].map(([label, value]) => (
                  <div class="rounded-xl border border-border/60 bg-surface/70 p-4">
                    <p class="text-xs text-muted-foreground">{label}</p>
                    <p class="mt-1 text-2xl font-semibold tracking-tight">{value}</p>
                  </div>
                ))}
              </div>
              <div class="mt-4 h-32 rounded-xl border border-border/60 bg-gradient-to-tr from-primary/10 via-transparent to-primary/5 p-4">
                <div class="flex h-full items-end gap-1.5">
                  {[20, 35, 28, 50, 42, 65, 58, 72, 60, 80, 75, 92].map((height) => (
                    <div class="flex-1 rounded-t bg-primary/70" style={`height:${height}%`}></div>
                  ))}
                </div>
              </div>
            </div>
          </BrowserFrame>

          <BrowserFrame title="yourbusiness.com" class="w-full">
            <div class="relative h-[360px] bg-grid">
              <div class="absolute bottom-4 right-4 w-[300px] overflow-hidden rounded-2xl border border-border-strong/60 bg-surface shadow-frame">
                <div class="flex items-center gap-2 bg-primary px-4 py-3 text-primary-foreground">
                  <div class="h-7 w-7 rounded-full bg-primary-foreground/15"></div>
                  <div>
                    <p class="text-sm font-semibold">Snoodlr Assistant</p>
                    <p class="text-[10px] opacity-80">Typically replies instantly</p>
                  </div>
                </div>
                <div class="space-y-2 p-3 text-xs">
                  <div class="max-w-[85%] rounded-xl bg-background/60 px-3 py-2 ring-1 ring-border">Hi! Looking for something specific?</div>
                  <div class="ml-auto max-w-[85%] rounded-xl bg-primary px-3 py-2 text-primary-foreground">What are your payment options?</div>
                  <div class="max-w-[85%] rounded-xl bg-background/60 px-3 py-2 ring-1 ring-border">We accept card, bank transfer, and cash on pickup. Want a team member to confirm the best option?</div>
                </div>
              </div>
            </div>
          </BrowserFrame>
        </div>
      </div>
    </section>

    <section class="relative py-20 md:py-28" id="use-cases">
      <div class="mx-auto max-w-7xl px-6">
        <div class="max-w-3xl">
          <Eyebrow label="Use cases" />
          <h2 class="mt-5 text-balance text-4xl font-semibold tracking-tight md:text-5xl">Built for businesses that talk to customers.</h2>
        </div>
        <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {useCases.map(([title, description]) => (
            <div class="rounded-2xl border border-border/60 bg-card p-7 transition-colors hover:border-primary/40">
              <h3 class="text-lg font-semibold tracking-tight">{title}</h3>
              <p class="mt-2 text-muted-foreground">{description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="relative border-y border-border/60 bg-surface/30 py-20 md:py-28" id="wordpress">
      <div class="mx-auto max-w-7xl px-6">
        <div class="grid items-center gap-12 md:grid-cols-2">
          <div>
            <Eyebrow label="WordPress & WooCommerce" />
            <h2 class="mt-5 text-balance text-4xl font-semibold tracking-tight md:text-5xl">Power up your WordPress site or WooCommerce store with Snoodlr.</h2>
            <p class="mt-5 text-lg leading-relaxed text-muted-foreground">Connect the Snoodlr WordPress plugin so your assistant can answer from your pages, policies, products, and WooCommerce store context.</p>
            <p class="mt-3 text-sm font-medium text-muted-foreground">WooCommerce features require the connected Snoodlr WordPress plugin.</p>
            <div class="mt-8">
              <ButtonLink href="#start">Get the plugin</ButtonLink>
            </div>
          </div>
          <div class="rounded-3xl border border-border-strong/60 bg-background p-8 shadow-frame">
            <div class="space-y-4">
              {[
                "Product discovery from your catalog",
                "Availability and product-policy questions",
                "Order requests and pending order details for your team to confirm",
                "Store-specific Q&A from products, pages, and policies",
                "Lead capture and human handoff from your website"
              ].map((item) => (
                <div class="flex items-start gap-3">
                  <span class="mt-1 h-5 w-5 flex-none rounded-md bg-primary/15 ring-1 ring-primary/40"></span>
                  <p class="text-foreground">{item}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="relative py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-6">
        <div class="max-w-3xl">
          <Eyebrow label="Built for business" />
          <h2 class="mt-5 text-balance text-4xl font-semibold tracking-tight md:text-5xl">Confidence baked into every conversation.</h2>
          <p class="mt-5 text-lg leading-relaxed text-muted-foreground">Snoodlr is designed around approved sources, team visibility, and practical controls so your assistant stays useful without becoming a black box.</p>
        </div>
        <div class="mt-12 grid gap-3 md:grid-cols-2 lg:grid-cols-3">
          {businessPoints.map((point) => (
            <div class="flex items-center gap-3 rounded-xl border border-border/60 bg-card px-5 py-4">
              <span class="h-2 w-2 rounded-full bg-primary"></span>
              <p class="font-medium">{point}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="relative border-y border-border/60 bg-surface/30 py-20 md:py-28" id="pricing">
      <div class="mx-auto max-w-7xl px-6">
        <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
          <div>
            <Eyebrow label="Pricing" />
            <h2 class="mt-5 text-balance text-4xl font-semibold tracking-tight md:text-5xl">Start free. Scale when the assistant is working.</h2>
            <p class="mt-5 text-lg leading-relaxed text-muted-foreground">Snoodlr is free to start. Paid plans are available for higher usage, more properties, more channels, and advanced controls, with Business and Enterprise support handled with our team.</p>
            <div class="mt-8 flex flex-wrap gap-3">
              <ButtonLink href={APP_LOGIN_URL}>Start free</ButtonLink>
              <ButtonLink href="/pricing" variant="secondary">See pricing</ButtonLink>
            </div>
          </div>
          <div class="grid gap-4 md:grid-cols-3 lg:grid-cols-1">
            {pricingHighlights.map(([title, description]) => (
              <div class="rounded-2xl border border-border/60 bg-card p-6">
                <div class="flex items-start gap-3">
                  <CheckIcon />
                  <div>
                    <h3 class="font-semibold tracking-tight">{title}</h3>
                    <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{description}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <CtaBand />
  </main>
</BaseLayout>
