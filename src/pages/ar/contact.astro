---
import BaseLayout from "../../components/BaseLayout.astro";
import Button from "../../components/Button.astro";
import ButtonLink from "../../components/ButtonLink.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import { appLoginUrl } from "../../lib/links";

const appLoginHref = appLoginUrl("ar");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "@id": "https://snoodlr.com/ar/contact#contact-page",
  name: "تواصل مع Snoodlr",
  url: "https://snoodlr.com/ar/contact",
  inLanguage: "ar",
  about: {
    "@type": "SoftwareApplication",
    "@id": "https://snoodlr.com/#software",
    name: "Snoodlr"
  },
  mainEntity: {
    "@id": "https://snoodlr.com/#organization"
  },
  contactPoint: {
    "@type": "ContactPoint",
    email: "hello@snoodlr.com",
    contactType: "customer support"
  }
};
---

<BaseLayout
  lang="ar"
  title="تواصل مع Snoodlr - الدعم والشراكات واستفسارات الأعمال"
  description="تحدث مع فريق Snoodlr بخصوص الدعم أو الشراكات أو استفسارات الأعمال، أو ابدأ مجانًا خلال دقائق."
  ogTitle="تواصل مع Snoodlr"
  ogDescription="لنتحدث عن Snoodlr: الدعم، الشراكات، واستفسارات الأعمال."
  path="/ar/contact"
  keywords={[
    "تواصل مع Snoodlr",
    "دعم Snoodlr",
    "شراكات Snoodlr",
    "دعم مساعد أعمال بالذكاء الاصطناعي",
    "استفسار شات بوت للأعمال"
  ]}
  jsonLd={jsonLd}
>
  <main class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 bg-hero-glow"></div>
    <div class="relative mx-auto max-w-6xl px-6 pb-24 pt-20 md:pt-28">
      <div class="max-w-2xl">
        <Eyebrow label="تواصل معنا" />
        <h1 class="mt-6 text-balance text-5xl font-semibold tracking-tight md:text-6xl">لنتحدث عن Snoodlr.</h1>
        <p class="mt-5 text-lg leading-relaxed text-muted-foreground">سواء كنت تحتاج إلى دعم، أو تريد استكشاف شراكة، أو لديك سؤال تجاري، نحن هنا. راسلنا وسنعود إليك بسرعة.</p>
      </div>

      <div class="mt-14 grid gap-8 md:grid-cols-5">
        <form
          class="rounded-3xl border border-border/60 bg-card p-7 md:col-span-3 md:p-9"
          action="/api/contact"
          method="post"
          data-contact-form
          data-success="شكرًا لك - تم إرسال رسالتك."
          data-error="تعذر إرسال الرسالة. يرجى المحاولة مرة أخرى."
          data-sending="جار الإرسال..."
        >
          <input type="hidden" name="locale" value="ar" />
          <input type="hidden" name="path" value="/ar/contact" />
          <label class="hidden" aria-hidden="true">
            Website
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>
          <div class="grid gap-5">
            <label class="block">
              <span class="mb-2 block text-sm font-medium text-foreground">اسمك</span>
              <input required type="text" class="h-11 w-full rounded-lg border border-border bg-input/40 px-4 text-foreground outline-none ring-primary/40 focus:ring-2" placeholder="الاسم" name="name" />
            </label>
            <label class="block">
              <span class="mb-2 block text-sm font-medium text-foreground">البريد الإلكتروني</span>
              <input required type="email" class="h-11 w-full rounded-lg border border-border bg-input/40 px-4 text-foreground outline-none ring-primary/40 focus:ring-2" placeholder="you@business.com" name="email" dir="ltr" />
            </label>
            <label class="block">
              <span class="mb-2 block text-sm font-medium text-foreground">الشركة (اختياري)</span>
              <input type="text" class="h-11 w-full rounded-lg border border-border bg-input/40 px-4 text-foreground outline-none ring-primary/40 focus:ring-2" placeholder="اسم الشركة" name="company" />
            </label>
            <label class="block">
              <span class="mb-2 block text-sm font-medium text-foreground">كيف يمكننا مساعدتك؟</span>
              <textarea required name="message" rows="5" class="w-full rounded-lg border border-border bg-input/40 px-4 py-3 text-foreground outline-none ring-primary/40 focus:ring-2" placeholder="أخبرنا قليلًا عن نشاطك وما الذي تبحث عنه."></textarea>
            </label>
          </div>
          <p data-contact-status class="mt-5 hidden rounded-xl border px-4 py-3 text-sm" role="status" aria-live="polite"></p>
          <div class="mt-7 flex flex-wrap items-center gap-3">
            <Button type="submit" lang="ar" data-contact-submit>إرسال الرسالة</Button>
            <p class="text-sm text-muted-foreground">سنرد على البريد الإلكتروني الذي تدخله.</p>
          </div>
        </form>

        <aside class="space-y-4 md:col-span-2">
          <div class="rounded-2xl border border-border/60 bg-card p-6">
            <p class="text-lg font-semibold tracking-tight">ابدأ مجانًا</p>
            <p class="mt-1.5 text-sm text-muted-foreground">تجاوز النموذج وأعد مساعد أعمالك بالذكاء الاصطناعي خلال دقائق.</p>
            <ButtonLink href={appLoginHref} size="md" lang="ar" class="mt-4">ابدأ مجانًا</ButtonLink>
          </div>
          <div class="rounded-2xl border border-border/60 bg-card p-6">
            <p class="text-lg font-semibold tracking-tight">تسجيل الدخول</p>
            <p class="mt-1.5 text-sm text-muted-foreground">تستخدم Snoodlr بالفعل؟ عد إلى مساحة عملك.</p>
            <ButtonLink href={appLoginHref} size="md" variant="secondary" lang="ar" class="mt-4">تسجيل الدخول</ButtonLink>
          </div>
          <div class="rounded-2xl border border-border/60 bg-surface/40 p-6">
            <p class="text-sm font-medium text-foreground">الاستفسارات</p>
            <ul class="mt-3 space-y-2 text-sm text-muted-foreground">
              <li>الدعم - المساعدة في حسابك</li>
              <li>الشراكات - التكاملات والموزعون</li>
              <li>الأعمال - الوكالات والتنفيذ المخصص</li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </main>
  <script>
    document.querySelectorAll("[data-contact-form]").forEach((form) => {
      if (!(form instanceof HTMLFormElement)) return;

      const status = form.querySelector("[data-contact-status]");
      const submit = form.querySelector("[data-contact-submit]");
      const button = submit instanceof HTMLButtonElement ? submit : null;
      const originalButtonText = button?.textContent ?? "";

      const setStatus = (message, type) => {
        if (!(status instanceof HTMLElement)) return;

        status.textContent = message;
        status.className = "mt-5 rounded-xl border px-4 py-3 text-sm";

        if (!message) {
          status.classList.add("hidden");
          return;
        }

        status.classList.add(
          type === "success" ? "border-primary/30" : "border-red-500/30",
          type === "success" ? "bg-primary/10" : "bg-red-500/10",
          "text-foreground"
        );
      };

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;

        setStatus("", "success");
        if (button) {
          button.disabled = true;
          button.textContent = form.dataset.sending || originalButtonText;
        }

        try {
          const response = await fetch(form.action, {
            method: "POST",
            headers: {
              Accept: "application/json"
            },
            body: new FormData(form)
          });
          const payload = await response.json().catch(() => ({}));

          if (!response.ok || !payload.ok) {
            throw new Error(payload.message || form.dataset.error || "تعذر إرسال الرسالة.");
          }

          form.reset();
          setStatus(form.dataset.success || "تم إرسال الرسالة.", "success");
        } catch (error) {
          const message = error instanceof Error ? error.message : form.dataset.error || "تعذر إرسال الرسالة.";
          setStatus(message, "error");
        } finally {
          if (button) {
            button.disabled = false;
            button.textContent = originalButtonText;
          }
        }
      });
    });
  </script>
</BaseLayout>
