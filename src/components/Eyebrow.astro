---
const { label } = Astro.props;
---

<span class="inline-flex items-center gap-2 rounded-full border border-border-strong/60 bg-surface/60 px-3 py-1 text-xs font-medium uppercase tracking-[0.14em] text-muted-foreground">
  <span class="h-1.5 w-1.5 rounded-full bg-primary"></span>
  {label}
</span>
