---
import type { SiteLang } from "../lib/links";
import { buttonClasses, buttonLabelClasses, type ButtonSize, type ButtonVariant } from "../lib/buttonStyles";

const {
  type = "button",
  variant = "primary",
  size = "lg",
  lang = "en",
  block = false,
  class: className = "",
  ...attrs
} = Astro.props as {
  type?: "button" | "submit" | "reset";
  variant?: ButtonVariant;
  size?: ButtonSize;
  lang?: SiteLang;
  block?: boolean;
  class?: string;
  [key: string]: unknown;
};

const buttonClass = buttonClasses({ variant, size, block, className });
const labelClass = buttonLabelClasses(lang);
---

<button type={type} class={buttonClass} {...attrs}>
  <span class={labelClass}>
    <slot />
  </span>
</button>
