---
import ThemeToggle from "./ThemeToggle";
import { APP_LOGIN_URL } from "../lib/links";

const { currentPath = "/" } = Astro.props;
const isPricing = currentPath.startsWith("/pricing");
const isContact = currentPath.startsWith("/contact");
const navLink = "text-sm text-muted-foreground transition-colors hover:text-foreground";
const activeLink = "text-sm text-foreground";
---

<header class="sticky top-0 z-50 border-b border-border/60 bg-background/80 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6">
    <a aria-label="Snoodlr home" href="/" class="flex items-center gap-2">
      <img src="/assets/snoodlr-logo.png" alt="Snoodlr" class="h-7 w-auto dark:brightness-0 dark:invert" />
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
      <a href="/#how-it-works" class={navLink}>How it works</a>
      <a href="/#use-cases" class={navLink}>Use cases</a>
      <a href="/pricing" class={isPricing ? activeLink : navLink} aria-current={isPricing ? "page" : undefined}>Pricing</a>
      <a href="/contact" class={isContact ? activeLink : navLink} aria-current={isContact ? "page" : undefined}>Contact</a>
    </nav>

    <div class="flex items-center gap-3">
      <ThemeToggle client:load />
      <a href={APP_LOGIN_URL} class="inline-flex h-10 items-center justify-center rounded-full bg-primary px-5 text-sm font-semibold text-primary-foreground shadow-soft transition-transform hover:scale-[1.02]">Start free</a>
    </div>
  </div>
</header>
