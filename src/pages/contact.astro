---
import BaseLayout from "../components/BaseLayout.astro";
import Button from "../components/Button.astro";
import ButtonLink from "../components/ButtonLink.astro";
import Eyebrow from "../components/Eyebrow.astro";
import { APP_LOGIN_URL } from "../lib/links";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Contact Snoodlr",
  url: "https://snoodlr.com/contact",
  about: {
    "@type": "SoftwareApplication",
    name: "Snoodlr"
  },
  contactPoint: {
    "@type": "ContactPoint",
    email: "hello@snoodlr.com",
    contactType: "customer support"
  }
};
---

<BaseLayout
  title="Contact Snoodlr - Support, partnerships, and business inquiries"
  description="Talk to the Snoodlr team about support, partnerships, and business inquiries - or start free in minutes."
  ogTitle="Contact Snoodlr"
  ogDescription="Let's talk about Snoodlr - support, partnerships, and business inquiries."
  path="/contact"
  jsonLd={jsonLd}
>
  <main class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 bg-hero-glow"></div>
    <div class="relative mx-auto max-w-6xl px-6 pb-24 pt-20 md:pt-28">
      <div class="max-w-2xl">
        <Eyebrow label="Contact" />
        <h1 class="mt-6 text-balance text-5xl font-semibold tracking-tight md:text-6xl">Let's talk about Snoodlr.</h1>
        <p class="mt-5 text-lg leading-relaxed text-muted-foreground">Whether you need support, want to explore a partnership, or have a business question - we're here. Reach out and we'll get back to you quickly.</p>
      </div>

      <div class="mt-14 grid gap-8 md:grid-cols-5">
        <form
          class="rounded-3xl border border-border/60 bg-card p-7 md:col-span-3 md:p-9"
          action="/api/contact"
          method="post"
          data-contact-form
          data-success="Thanks - your message has been sent."
          data-error="We could not send your message. Please try again."
          data-sending="Sending..."
        >
          <input type="hidden" name="locale" value="en" />
          <input type="hidden" name="path" value="/contact" />
          <label class="hidden" aria-hidden="true">
            Website
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>
          <div class="grid gap-5">
            <label class="block">
              <span class="mb-2 block text-sm font-medium text-foreground">Your name</span>
              <input required type="text" class="h-11 w-full rounded-lg border border-border bg-input/40 px-4 text-foreground outline-none ring-primary/40 focus:ring-2" placeholder="Jane Doe" name="name" />
            </label>
            <label class="block">
              <span class="mb-2 block text-sm font-medium text-foreground">Email</span>
              <input required type="email" class="h-11 w-full rounded-lg border border-border bg-input/40 px-4 text-foreground outline-none ring-primary/40 focus:ring-2" placeholder="you@business.com" name="email" />
            </label>
            <label class="block">
              <span class="mb-2 block text-sm font-medium text-foreground">Company (optional)</span>
              <input type="text" class="h-11 w-full rounded-lg border border-border bg-input/40 px-4 text-foreground outline-none ring-primary/40 focus:ring-2" placeholder="Acme Co." name="company" />
            </label>
            <label class="block">
              <span class="mb-2 block text-sm font-medium text-foreground">How can we help?</span>
              <textarea required name="message" rows="5" class="w-full rounded-lg border border-border bg-input/40 px-4 py-3 text-foreground outline-none ring-primary/40 focus:ring-2" placeholder="Tell us a bit about your business and what you're looking for."></textarea>
            </label>
          </div>
          <p data-contact-status class="mt-5 hidden rounded-xl border px-4 py-3 text-sm" role="status" aria-live="polite"></p>
          <div class="mt-7 flex flex-wrap items-center gap-3">
            <Button type="submit" data-contact-submit>Send message</Button>
            <p class="text-sm text-muted-foreground">We'll reply to the email you enter.</p>
          </div>
        </form>

        <aside class="space-y-4 md:col-span-2">
          <div class="rounded-2xl border border-border/60 bg-card p-6">
            <p class="text-lg font-semibold tracking-tight">Start free</p>
            <p class="mt-1.5 text-sm text-muted-foreground">Skip the form - set up your AI business assistant in minutes.</p>
            <ButtonLink href={APP_LOGIN_URL} size="md" class="mt-4">Start free</ButtonLink>
          </div>
          <div class="rounded-2xl border border-border/60 bg-card p-6">
            <p class="text-lg font-semibold tracking-tight">Sign in</p>
            <p class="mt-1.5 text-sm text-muted-foreground">Already using Snoodlr? Jump back into your workspace.</p>
            <ButtonLink href={APP_LOGIN_URL} size="md" variant="secondary" class="mt-4">Sign in</ButtonLink>
          </div>
          <div class="rounded-2xl border border-border/60 bg-surface/40 p-6">
            <p class="text-sm font-medium text-foreground">Inquiries</p>
            <ul class="mt-3 space-y-2 text-sm text-muted-foreground">
              <li>Support - help with your account</li>
              <li>Partnerships - integrations and resellers</li>
              <li>Business - agencies and custom work</li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </main>
  <script>
    document.querySelectorAll("[data-contact-form]").forEach((form) => {
      if (!(form instanceof HTMLFormElement)) return;

      const status = form.querySelector("[data-contact-status]");
      const submit = form.querySelector("[data-contact-submit]");
      const button = submit instanceof HTMLButtonElement ? submit : null;
      const originalButtonText = button?.textContent ?? "";

      const setStatus = (message, type) => {
        if (!(status instanceof HTMLElement)) return;

        status.textContent = message;
        status.className = "mt-5 rounded-xl border px-4 py-3 text-sm";

        if (!message) {
          status.classList.add("hidden");
          return;
        }

        status.classList.add(
          type === "success" ? "border-primary/30" : "border-red-500/30",
          type === "success" ? "bg-primary/10" : "bg-red-500/10",
          "text-foreground"
        );
      };

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;

        setStatus("", "success");
        if (button) {
          button.disabled = true;
          button.textContent = form.dataset.sending || originalButtonText;
        }

        try {
          const response = await fetch(form.action, {
            method: "POST",
            headers: {
              Accept: "application/json"
            },
            body: new FormData(form)
          });
          const payload = await response.json().catch(() => ({}));

          if (!response.ok || !payload.ok) {
            throw new Error(payload.message || form.dataset.error || "We could not send your message.");
          }

          form.reset();
          setStatus(form.dataset.success || "Message sent.", "success");
        } catch (error) {
          const message = error instanceof Error ? error.message : form.dataset.error || "We could not send your message.";
          setStatus(message, "error");
        } finally {
          if (button) {
            button.disabled = false;
            button.textContent = originalButtonText;
          }
        }
      });
    });
  </script>
</BaseLayout>
