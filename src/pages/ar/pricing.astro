---
import BaseLayout from "../../components/BaseLayout.astro";
import ButtonLink from "../../components/ButtonLink.astro";
import CheckIcon from "../../components/CheckIcon.astro";
import CtaBand from "../../components/CtaBand.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import { appLoginUrl } from "../../lib/links";

const appLoginHref = appLoginUrl("ar");

const plans = [
  {
    name: "البدء المجاني",
    price: "$0",
    cadence: "للبدء",
    description: "جرّب Snoodlr على موقعك واعرف ما يسأل عنه العملاء قبل اختيار خطة مدفوعة.",
    cta: "ابدأ مجانًا",
    href: appLoginHref,
    featured: false,
    features: ["مساعد للموقع", "مصادر نشاط معتمدة", "جمع عملاء أساسي", "محادثات داخل البوابة", "ترقية بمساعدة الفريق"]
  },
  {
    name: "النمو",
    price: "مدفوعة",
    cadence: "مع نموك",
    description: "للأنشطة التي تحتاج إلى استخدام أعلى، ومواقع أو فروع أكثر، وقنوات وتحكم أكبر.",
    cta: "تواصل معنا",
    href: "/ar/contact",
    featured: true,
    features: ["استخدام محادثات أعلى", "مواقع أو مساعدين أكثر", "جمع عملاء متقدم", "صندوق وارد موحد للقنوات المدعومة", "رسائل وتعليقات التواصل عند تفعيلها", "توفر إضافة ووردبريس"]
  },
  {
    name: "الأعمال",
    price: "تواصل معنا",
    cadence: "",
    description: "للفرق التي تحتاج إلى دعم إطلاق، ومراجعة محادثات، واحتياجات قنوات أوسع.",
    cta: "تواصل معنا",
    href: "/ar/contact",
    featured: false,
    features: ["عدة مواقع أو فروع", "تحويلات عمل للفريق", "دعم WooCommerce عبر الإضافة", "تحكم في الاستخدام والصلاحيات", "تحليلات ومراجعة التعليقات والمحادثات"]
  },
  {
    name: "المؤسسات",
    price: "مخصص",
    cadence: "",
    description: "للمؤسسات الأكبر التي تحتاج إلى حدود مخصصة أو تأهيل أو متطلبات تكامل خاصة.",
    cta: "تواصل مع المبيعات",
    href: "/ar/contact",
    featured: false,
    features: ["حدود استخدام ومواقع مخصصة", "تخطيط الإطلاق", "مراجعة متطلبات القنوات", "خيارات دعم بأولوية", "نقاش أمني وشرائي"]
  }
];

const rows = [
  ["ودجت الموقع", true, true, true, true],
  ["الموقع والمستندات والسياسات المعتمدة", true, true, true, true],
  ["جمع العملاء المحتملين", "أساسي", "متقدم", "متقدم", "مخصص"],
  ["بوابة المحادثات والعملاء", true, true, true, true],
  ["صندوق وارد موحد للقنوات المتصلة", false, true, true, true],
  ["رسائل وتعليقات وسائل التواصل", false, "عند التفعيل", "عند التفعيل", "عند التفعيل"],
  ["مراجعة المحادثات وتحديث المعلومات الناقصة", "أساسي", "متقدم", "متقدم", "مخصص"],
  ["حدود استخدام أعلى", false, true, true, true],
  ["مواقع أو مساعدين أكثر", false, true, true, true],
  ["قنوات مدعومة خارج الموقع", false, "عند التفعيل", "عند التفعيل", "عند التفعيل"],
  ["إضافة ووردبريس", false, "متاحة", "متاحة", "متاحة"],
  ["دعم متجر WooCommerce", false, "مع الإضافة", "مع الإضافة", "مع الإضافة"],
  ["تحكم متقدم", false, true, true, true],
  ["دعم الإطلاق", false, false, true, true],
  ["حدود أو متطلبات مخصصة", false, false, "نقاش", "مخصص"]
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": "https://snoodlr.com/#software",
  name: "Snoodlr",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  url: "https://snoodlr.com/ar/pricing",
  description: "أسعار Snoodlr تبدأ مجانًا، مع خطط مدفوعة لصندوق وارد موحد واستخدام أعلى ومواقع أكثر وقنوات مدعومة وتحكم متقدم.",
  inLanguage: "ar",
  publisher: {
    "@id": "https://snoodlr.com/#organization"
  },
  offers: plans.map((plan) => ({
    "@type": "Offer",
    name: plan.name,
    ...(plan.price === "$0" ? { price: "0", priceCurrency: "USD" } : {})
  }))
};
---

<BaseLayout
  lang="ar"
  title="الأسعار - Snoodlr مساعد أعمال بالذكاء الاصطناعي"
  description="ابدأ Snoodlr مجانًا، ثم تواصل مع فريقنا حول الخطط المدفوعة لصندوق وارد موحد واستخدام أعلى ومواقع أكثر وقنوات إضافية وتحكم متقدم."
  ogTitle="الأسعار - Snoodlr"
  ogDescription="Snoodlr مجاني للبدء، مع خطط مدفوعة لصندوق وارد موحد واستخدام أعلى ومواقع أكثر وقنوات إضافية وتحكم متقدم."
  path="/ar/pricing"
  keywords={[
    "أسعار Snoodlr",
    "أسعار مساعد أعمال بالذكاء الاصطناعي",
    "أسعار شات بوت للأعمال",
    "أسعار جمع العملاء المحتملين",
    "أسعار مساعد WooCommerce"
  ]}
  jsonLd={jsonLd}
>
  <main class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 bg-hero-glow"></div>

    <section class="relative py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-6">
        <div class="mx-auto max-w-3xl text-center">
          <Eyebrow label="الأسعار" />
          <h1 class="mt-5 text-balance text-4xl font-semibold tracking-tight md:text-5xl">أسعار بسيطة. نتائج جدية.</h1>
          <p class="mt-5 text-lg leading-relaxed text-muted-foreground">ابدأ مجانًا على موقعك. الخطط المدفوعة متاحة لاستخدام أعلى، ومواقع أكثر، وقنوات إضافية، وتحكم متقدم.</p>
        </div>

        <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {plans.map((plan) => (
            <div class={`relative flex flex-col rounded-3xl border p-7 ${plan.featured ? "border-primary/60 bg-card shadow-frame" : "border-border/60 bg-card/60"}`}>
              {plan.featured && <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-primary px-3 py-0.5 text-xs font-semibold text-primary-foreground">الأكثر اختيارًا</span>}
              <div class="flex-1">
                <h2 class="text-lg font-semibold tracking-tight">{plan.name}</h2>
                <div class="mt-2 flex items-baseline gap-1">
                  <span class="text-4xl font-semibold tracking-tight">{plan.price}</span>
                  {plan.cadence && <span class="text-sm text-muted-foreground">{plan.cadence}</span>}
                </div>
                <p class="mt-2 text-sm text-muted-foreground">{plan.description}</p>
                <ul class="mt-6 space-y-2.5">
                  {plan.features.map((feature) => (
                    <li class="flex items-start gap-2 text-sm text-foreground">
                      <CheckIcon />
                      {feature}
                    </li>
                  ))}
                </ul>
              </div>
              <ButtonLink href={plan.href} size="card" variant={plan.featured ? "primary" : "secondary"} lang="ar" block class="mt-7">{plan.cta}</ButtonLink>
            </div>
          ))}
        </div>

        <p class="mt-8 text-center text-sm text-muted-foreground">تفعيل الخطط المدفوعة والفوترة يتمان مع فريقنا حاليًا، حتى تناسب أسعار الأعمال والمؤسسات خطة الإطلاق.</p>
      </div>
    </section>

    <section class="relative border-y border-border/60 bg-surface/30 py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-6">
        <div class="max-w-3xl">
          <Eyebrow label="المقارنة" />
          <h2 class="mt-5 text-balance text-4xl font-semibold tracking-tight md:text-5xl">ما الذي تتضمنه الخطط؟</h2>
          <p class="mt-5 text-lg leading-relaxed text-muted-foreground">كل خطة تبدأ بتجربة Snoodlr الأساسية. قم بالترقية عندما تحتاج إلى حجم أكبر، أو مواقع أكثر، أو قنوات مدعومة، أو تحكم أعلى.</p>
        </div>

        <div class="mt-12 overflow-x-auto">
          <table class="w-full min-w-[640px] text-right text-sm">
            <thead>
              <tr class="border-b border-border-strong">
                <th class="py-3 pl-4 font-medium text-muted-foreground">الميزة</th>
                {plans.map((plan) => <th class="px-4 py-3 font-semibold text-foreground">{plan.name}</th>)}
              </tr>
            </thead>
            <tbody>
              {rows.map(([label, free, essential, business, enterprise]) => (
                <tr class="border-b border-border/40">
                  <td class="py-3 pl-4 font-medium text-foreground">{label}</td>
                  {[free, essential, business, enterprise].map((value) => (
                    <td class="px-4 py-3 text-muted-foreground">
                      {value === true ? <CheckIcon /> : value === false ? <span class="text-muted-foreground/40">&mdash;</span> : <span>{value}</span>}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <CtaBand lang="ar" contactHref="/ar/contact" />
  </main>
</BaseLayout>
